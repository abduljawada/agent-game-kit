[ext_resource type="PackedScene" path="res://example/checkpoint.tscn" id="checkpoint"]
[ext_resource type="PackedScene" path="res://kit/ui/hud.tscn" id="hud"]
[ext_resource type="PackedScene" path="res://kit/ui/pause_menu.tscn" id="pause"]
[ext_resource type="Script" path="res://kit/level/ascii_tilemap_layer.gd" id="ascii"]
[ext_resource type="TileSet" path="res://example/pixel_platformer_tiles.tres" id="tileset"]
[ext_resource type="Script" path="res://addons/phantom_camera/scripts/phantom_camera_host/phantom_camera_host.gd" id="pcam_host"]
[ext_resource type="Script" path="res://addons/phantom_camera/scripts/phantom_camera/phantom_camera_2d.gd" id="pcam"]
[ext_resource type="Script" path="res://kit/mechanics/dialogue_trigger.gd" id="dtrigger"]
[ext_resource type="Resource" path="res://example/guide.dialogue" id="guide_dialogue"]
[ext_resource type="Script" path="res://kit/mechanics/kill_zone.gd" id="killzone"]
[ext_resource type="Texture2D" path="res://assets/kenney/2d-pixel-platformer/Tilemap/tilemap-characters_packed.png" id="chars"]

[sub_resource type="AtlasTexture" id="guide_tex"]
atlas = ExtResource("chars")
region = Rect2(144, 0, 24, 24)
filter_clip = true

[sub_resource type="RectangleShape2D" id="npc_reach"]
size = Vector2(48, 30)

[sub_resource type="RectangleShape2D" id="pit"]
size = Vector2(1600, 40)

[node name="Level01" type="Node2D"]

[node name="Sky" type="CanvasLayer" parent="."]
layer = -10

[node name="Color" type="ColorRect" parent="Sky"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.73, 0.89, 0.96, 1)

[node name="Tiles" type="TileMapLayer" parent="."]
tile_set = ExtResource("tileset")
script = ExtResource("ascii")
layout_file = "res://example/level_01.txt"
solids = {
"#": {
"bottom": Vector2i(2, 7),
"bottom_left": Vector2i(1, 7),
"bottom_right": Vector2i(3, 7),
"fill": Vector2i(2, 6),
"fill_left": Vector2i(1, 6),
"fill_right": Vector2i(3, 6),
"single": Vector2i(0, 1),
"top": Vector2i(2, 1),
"top_left": Vector2i(1, 1),
"top_right": Vector2i(3, 1)
}
}
rows = {
"=": {
"left": Vector2i(8, 2),
"middle": Vector2i(9, 2),
"right": Vector2i(10, 2),
"single": Vector2i(9, 2)
}
}
entities = {
"^": ExtResource("spikes"),
"c": ExtResource("coin")
}
markers = {
"E": NodePath("../Enemy"),
"F": NodePath("../Checkpoint"),
"G": NodePath("../Guide"),
"P": NodePath("../Player")
}
entity_parent = NodePath("../Entities")

[node name="Entities" type="Node2D" parent="."]

[node name="Player" parent="." instance=ExtResource("player")]

[node name="Guide" type="Area2D" parent="."]
collision_layer = 0
collision_mask = 2
script = ExtResource("dtrigger")
dialogue = ExtResource("guide_dialogue")

[node name="CollisionShape2D" type="CollisionShape2D" parent="Guide"]
position = Vector2(0, -12)
shape = SubResource("npc_reach")

[node name="Visual" type="Sprite2D" parent="Guide"]
position = Vector2(0, -12)
texture = SubResource("guide_tex")

[node name="Enemy" parent="." instance=ExtResource("enemy")]

[node name="Checkpoint" parent="." instance=ExtResource("checkpoint")]

[node name="KillZone" type="Area2D" parent="."]
position = Vector2(720, 330)
collision_layer = 0
collision_mask = 6
script = ExtResource("killzone")

[node name="CollisionShape2D" type="CollisionShape2D" parent="KillZone"]
shape = SubResource("pit")

[node name="Camera2D" type="Camera2D" parent="."]
process_callback = 0

[node name="PhantomCameraHost" type="Node" parent="Camera2D"]
script = ExtResource("pcam_host")

[node name="PlayerCamera" type="Node2D" parent="." node_paths=PackedStringArray("follow_target")]
script = ExtResource("pcam")
priority = 10
follow_mode = 2
follow_target = NodePath("../Player")
zoom = Vector2(2, 2)
tween_on_load = false
follow_offset = Vector2(0, -24)
follow_damping = true
follow_damping_value = Vector2(0.15, 0.25)
limit_left = 0
limit_top = -100
limit_right = 1440
limit_bottom = 270

[node name="HUD" parent="." instance=ExtResource("hud")]

[node name="PauseMenu" parent="." instance=ExtResource("pause")]
